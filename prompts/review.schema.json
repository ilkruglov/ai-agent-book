{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_sha256",
    "translation_sha256",
    "model_id",
    "issues"
  ],
  "properties": {
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "translation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_id": {
      "const": "claude-opus-4-8"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "severity",
          "source_start_line",
          "source_end_line",
          "target_start_line",
          "target_end_line",
          "evidence",
          "proposed_replacement"
        ],
        "properties": {
          "category": {
            "enum": [
              "semantic",
              "omission",
              "addition",
              "russian",
              "terminology",
              "markdown"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "source_start_line": {
            "type": "integer",
            "minimum": 1
          },
          "source_end_line": {
            "type": "integer",
            "minimum": 1
          },
          "target_start_line": {
            "type": "integer",
            "minimum": 1
          },
          "target_end_line": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "proposed_replacement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
